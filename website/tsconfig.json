{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client"],
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    // The examples use the repository build; MapLibre types must come from one copy.
    "paths": {
      "@jorisvdmije/map-master": ["../dist/index.d.ts"],
      "maplibre-gl": ["./node_modules/maplibre-gl"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx"]
}
