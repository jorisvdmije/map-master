{
  "name": "map-master-documentation",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.22.3 || ^24.15.0"
  },
  "scripts": {
    "content": "tsx scripts/content.mjs",
    "dev": "npm run content && next dev --hostname 127.0.0.1 --port 5180",
    "build": "npm run content && next build && node scripts/export.mjs",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "check:content": "node scripts/content-check.mjs",
    "check:frameworks": "node scripts/frameworks.mjs",
    "check:browser": "node scripts/smoke.mjs",
    "check:playground": "node scripts/playground-browsers.mjs",
    "test:analysis": "tsx --test scripts/analysis-model.test.mjs scripts/bnb-model.test.mjs scripts/streets-model.test.mjs",
    "check:analysis": "node scripts/analysis-browsers.mjs",
    "check:bnb": "node scripts/analysis-browsers.mjs --bnb",
    "check": "node scripts/check.mjs",
    "lint": "eslint . --max-warnings 0",
    "check:streets": "node scripts/streets-browsers.mjs",
    "data:streets": "node scripts/fetch-streets.mjs",
    "data:street-observations": "tsx scripts/fetch-street-observations.mjs",
    "check:heatmaps": "node scripts/heatmap-browsers.mjs",
    "check:properties": "node scripts/property-cards-browsers.mjs"
  },
  "overrides": {
    "eslint@10.13.0": {
      "minimatch": "11.0.1"
    },
    "@eslint/config-array@0.23.5": {
      "minimatch": "11.0.1"
    },
    "@typescript-eslint/typescript-estree@8.72.1": {
      "minimatch": "11.0.1"
    }
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@tanstack/react-query": "5.105.1",
    "@turf/area": "7.4.0",
    "@turf/bbox": "7.4.0",
    "@turf/boolean-intersects": "7.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "html-react-parser": "6.1.9",
    "lucide-react": "1.66.0",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "papaparse": "5.7.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@angular/compiler": "22.2.4",
    "@angular/compiler-cli": "22.2.4",
    "@angular/core": "22.2.4",
    "@fontsource-variable/dm-sans": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/geojson": "7946.0.16",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vue/compiler-sfc": "3.5.44",
    "eslint": "10.13.0",
    "eslint-config-next": "16.4.3",
    "marked": "18.1.2",
    "playwright": "1.64.1",
    "prettier": "3.6.2",
    "rxjs": "7.8.2",
    "shiki": "4.5.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vue": "3.5.44",
    "vue-tsc": "3.3.14"
  }
