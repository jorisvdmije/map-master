{
  "name": "@jorisvdmije/map-master",
  "version": "0.1.0",
  "description": "Interactive geometry editor for MapLibre GL JS: draw, select, edit, snap, split, merge and transform GeoJSON features with undo/redo.",
  "keywords": [
    "maplibre",
    "maplibre-gl",
    "map",
    "geojson",
    "geometry",
    "editor",
    "draw",
    "drawing",
    "edit",
    "polygon",
    "linestring",
    "snapping",
    "undo",
    "typescript"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "CHANGELOG.md",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^22.13.0 || ^24.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "npm",
      "onFail": "warn"
    }
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.example.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:browser && npm run build:demo && npm run test:workspace && npm run test:docs",
    "prepack": "npm run build",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "dev": "npm run build && vite",
    "build:demo": "npm run build && vite build",
    "benchmark": "npm run build && node benchmarks/run.mjs",
    "dev:workspace": "node scripts/workspace.mjs dev",
    "dev:workspace:published": "node scripts/published-workspace.mjs dev",
    "test:workspace:published": "node --test scripts/published-workspace.test.mjs && node scripts/published-workspace.mjs check",
    "test:compatibility": "node --test scripts/workspace-compatibility.test.mjs && node scripts/workspace.mjs compatibility",
    "test:compatibility:published": "node --test scripts/workspace-compatibility.test.mjs && node scripts/published-workspace.mjs compatibility",
    "test:budgets": "node --test scripts/beta-budget-policy.test.mjs && node scripts/workspace.mjs budgets",
    "test:workspace": "node --test scripts/beta-budget-policy.test.mjs && node scripts/workspace.mjs check",
    "lock:workspace": "node scripts/workspace.mjs lock",
    "release:prepare": "node scripts/prepare-release.mjs",
    "dev:docs": "npm --prefix website run dev",
    "build:docs": "npm --prefix website run build",
    "test:docs": "npm --prefix website run check"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "maplibre-gl": "6.15.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.15.0"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "robust-predicates": "3.0.3"
  },
  "author": {
    "name": "jorisvdmije",
    "url": "https://github.com/jorisvdmije"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorisvdmije/map-master.git"
  },
  "homepage": "https://github.com/jorisvdmije/map-master#readme",
  "bugs": {
    "url": "https://github.com/jorisvdmije/map-master/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "latest"
  }
}
