{
  "name": "@jorisvdmije/map-master",
  "version": "0.1.0-beta.0",
  "private": true,
  "description": "Map Master: a TypeScript geometry editor for MapLibre web maps.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "docs",
    "CONTRIBUTING.md",
    "CHANGELOG.md",
    "LICENSE",
    "SECURITY.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.example.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:browser && npm run build:demo && npm run test:workspace",
    "prepack": "npm run build",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "dev": "npm run build && vite",
    "build:demo": "npm run build && vite build",
    "benchmark:markers": "npm run build && node scripts/benchmark-markers.mjs",
    "benchmark:multipart": "npm run build && node scripts/benchmark-multipart.mjs",
    "benchmark:holes": "npm run build && node scripts/benchmark-holes.mjs",
    "benchmark:polygon": "npm run build && node scripts/benchmark-polygon.mjs",
    "benchmark:duplication": "npm run build && node scripts/benchmark-duplication.mjs",
    "benchmark:translation": "npm run build && node scripts/benchmark-translation.mjs",
    "benchmark:selection": "npm run build && node scripts/benchmark-selection.mjs",
    "benchmark:deletion": "npm run build && node scripts/benchmark-deletion.mjs",
    "benchmark:editing": "npm run build && node scripts/benchmark-editing.mjs",
    "benchmark:import": "npm run build && node scripts/benchmark-import.mjs",
    "benchmark:history": "npm run build && node scripts/benchmark-history.mjs",
    "benchmark:snapping": "npm run build && node scripts/benchmark-snapping.mjs",
    "benchmark:transactions": "npm run build && node scripts/benchmark-transactions.mjs",
    "benchmark:split": "npm run build && node scripts/benchmark-split.mjs",
    "benchmark:union": "npm run build && node scripts/benchmark-union.mjs",
    "benchmark:offset": "npm run build && node scripts/benchmark-offset.mjs",
    "benchmark:buffer": "npm run build && node scripts/benchmark-buffer.mjs",
    "benchmark:simplification": "npm run build && node scripts/benchmark-simplification.mjs",
    "benchmark:constraints": "npm run build && node scripts/benchmark-constraints.mjs",
    "benchmark:scaling": "npm run build && node scripts/benchmark-scaling.mjs",
    "benchmark:rotation": "npm run build && node scripts/benchmark-rotation.mjs",
    "benchmark:shared-boundary": "npm run build && node scripts/benchmark-shared-boundary.mjs",
    "benchmark:trace": "npm run build && node scripts/benchmark-trace.mjs",
    "benchmark:reshape": "npm run build && node scripts/benchmark-reshape.mjs",
    "benchmark:intersection": "npm run build && node scripts/benchmark-intersection.mjs",
    "benchmark:difference": "npm run build && node scripts/benchmark-difference.mjs",
    "dev:workspace": "node scripts/workspace.mjs dev",
    "test:budgets": "node --test scripts/beta-budget-policy.test.mjs && node scripts/workspace.mjs budgets",
    "test:workspace": "node --test scripts/beta-budget-policy.test.mjs && node scripts/workspace.mjs check",
    "lock:workspace": "node scripts/workspace.mjs lock",
    "release:prepare": "node scripts/prepare-release.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "maplibre-gl": "6.15.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.15.0"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "robust-predicates": "3.0.3"
  },
  "author": {
    "name": "jorisvdmije",
    "url": "https://github.com/jorisvdmije"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jorisvdmije/map-master.git"
  },
  "homepage": "https://github.com/jorisvdmije/map-master#readme",
  "bugs": {
    "url": "https://github.com/jorisvdmije/map-master/issues"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public",
    "tag": "beta"
  }
}
