{
  "name": "@geo/editor",
  "version": "0.0.0",
  "private": true,
  "description": "A TypeScript geometry editor for web maps (early development).",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "assets/icon.svg",
    "docs",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": "^22.13.0 || ^24.0.0"
  },
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true });\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.core.json && tsc -p tsconfig.tools.json && tsc -p tsconfig.example.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test && npm run test:browser && npm run build:demo",
    "prepack": "npm run build",
    "test:browser": "npm run build && vitest run --config vitest.browser.config.ts",
    "dev": "npm run build && vite",
    "build:demo": "npm run build && vite build",
    "benchmark:multipart": "npm run build && node scripts/benchmark-multipart.mjs",
    "benchmark:holes": "npm run build && node scripts/benchmark-holes.mjs",
    "benchmark:polygon": "npm run build && node scripts/benchmark-polygon.mjs",
    "benchmark:duplication": "npm run build && node scripts/benchmark-duplication.mjs",
    "benchmark:translation": "npm run build && node scripts/benchmark-translation.mjs",
    "benchmark:selection": "npm run build && node scripts/benchmark-selection.mjs",
    "benchmark:deletion": "npm run build && node scripts/benchmark-deletion.mjs",
    "benchmark:editing": "npm run build && node scripts/benchmark-editing.mjs",
    "benchmark:import": "npm run build && node scripts/benchmark-import.mjs",
    "benchmark:history": "npm run build && node scripts/benchmark-history.mjs",
    "benchmark:snapping": "npm run build && node scripts/benchmark-snapping.mjs",
    "benchmark:transactions": "npm run build && node scripts/benchmark-transactions.mjs",
    "benchmark:split": "npm run build && node scripts/benchmark-split.mjs",
    "benchmark:union": "npm run build && node scripts/benchmark-union.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/geojson": "7946.0.16",
    "@types/node": "22.20.5",
    "@vitest/browser-playwright": "5.0.5",
    "eslint": "10.13.0",
    "maplibre-gl": "6.15.0",
    "playwright": "1.64.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "maplibre-gl": "^6.15.0"
  },
  "dependencies": {
    "polygon-clipping": "0.15.7",
    "robust-predicates": "3.0.3"
  }
}
